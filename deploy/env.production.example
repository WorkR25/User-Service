# Copy to deploy/.env.production on the server and fill in every CHANGE_ME.
#   cp deploy/env.production.example deploy/.env.production && chmod 600 deploy/.env.production
# Quote values that contain '#' or spaces, e.g. DB_PASSWORD="pa#ss word". Avoid '$' in values (Compose expands it; write '$$' for a literal one). Never commit the real file.

# ---- Where the container is published on the host ----
# The container always listens on 3000. 127.0.0.1 = reachable only by the reverse proxy (nginx) on this server.
# Use 0.0.0.0 only if clients hit this port directly (no proxy).
HOST_BIND=127.0.0.1
HOST_PORT=3000

# ---- App ----
SALT=12
JWT_SECRET=CHANGE_ME
# CORS origin of the WorkR frontend, e.g. https://workr.club
FRONTEND_URL=CHANGE_ME

# ---- MySQL (NOT localhost: inside the container that is the container itself) ----
# MySQL on this same server -> host.docker.internal
DB_HOST=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=CHANGE_ME

# ---- AWS S3 (uploads) ----
AWS_REGION=CHANGE_ME
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_S3_BUCKET_NAME=CHANGE_ME

# ---- Redis: the workr-redis container owned by the notification-service stack ----
REDIS_HOST=workr-redis
REDIS_PORT=6379
# MUST be identical to REDIS_PASSWORD in notification-service's deploy/workr-server/.env.production
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0
REDIS_TLS=false

# ---- Lead nurture: enqueue the signup notification ----
# Master switch: false = signups are never queued
NOTIFICATIONS_ENABLED=true
# Must match notification-service's constants
LEAD_NURTURE_QUEUE_NAME=workr-signup-notification-queue
LEAD_NURTURE_JOB_NAME=payload:workr-signup-notification
READINESS_LINK_BASE_URL=https://ai-proof-engineering-readiness-chec.vercel.app/
ENQUEUE_TIMEOUT_MS=5000

# ---- Admin panel -> notification-service delivery lookup (same server, via the docker network) ----
NOTIFICATION_SERVICE_BASE_URL=http://notification-service:3000/api/v1
# MUST equal WORKR_LOOKUP_API_KEY in notification-service's .env.production
NOTIFICATION_LOOKUP_API_KEY=CHANGE_ME
NOTIFICATION_LOOKUP_API_KEY_HEADER=x-workr-lookup-key

# ---- Day 2-15 nurture scheduler (runs inside this process, so run ONE instance only) ----
# Safe defaults: off, and when switched on it only logs until LEAD_NURTURE_DRY_RUN=false
LEAD_NURTURE_SCHEDULER_ENABLED=false
LEAD_NURTURE_DRY_RUN=true
# VSL (candidate-form-details-service) engagement lookup, e.g. https://<form api domain>/api/v1
VSL_API_BASE_URL=
VSL_WORKR_API_KEY=
